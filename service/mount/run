#!/system/bin/sh
# openlist runsv service (main service) -- "mount" variant.
# The binary is shipped in the module and mounted at /system/bin/openlist, so
# it stays readable/executable after chpst drops privileges to a normal user.
# This variant runs as the shell user with the storage groups and keeps its
# data on shared storage.
# Settings live in ./conf next to this script.
# Installed to /data/adb/runsvdir/service/openlist/run on a fresh install.
# Edit run / conf freely: they are only written again when the installer's
# "update scripts" option is used.
exec 2>&1

cd "$(dirname "$0")" || exit 1

. ./conf

# chpst is a runit applet; runsvdir-magisk installs it into /system/bin.
if [ -x /system/bin/chpst ]; then
    CHPST=/system/bin/chpst
else
    CHPST=chpst
fi

if [ "$WAIT_DECRYPT" != "0" ]; then
    echo "openlist(runsv): waiting for user storage decryption..."
    if [ "$(getprop sys.user.0.ce_available)" != "true" ]; then
        echo "openlist(runsv): storage not decrypted yet, retrying"
        sleep 10
        exit 1
    fi
    echo "openlist(runsv): storage ready"
fi

exec "$CHPST" -u "$RUN_AS" openlist server --data "$OPENLIST_DATA"
