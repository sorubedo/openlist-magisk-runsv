#!/system/bin/sh
# openlist runsv service (main service) -- "nomount" variant.
# The binary lives in ./bin/openlist inside this folder and nothing is mounted
# to /system. This variant does not drop privileges: it runs as root and keeps
# its data in ./data next to this script.
# Settings live in ./conf next to this script.
# Installed to /data/adb/runsvdir/service/openlist/run on a fresh install.
# Edit run / conf freely: they are only written again when the installer's
# "update scripts" option is used.
exec 2>&1

cd "$(dirname "$0")" || exit 1

. ./conf

if [ "$WAIT_DECRYPT" != "0" ]; then
    echo "openlist(runsv): waiting for user storage decryption..."
    if [ "$(getprop sys.user.0.ce_available)" != "true" ]; then
        echo "openlist(runsv): storage not decrypted yet, retrying"
        sleep 10
        exit 1
    fi
    echo "openlist(runsv): storage ready"
fi

exec ./bin/openlist server --data "$OPENLIST_DATA"
